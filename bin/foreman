#!/usr/bin/env bash
# foreman - start the foreman session: pi, in this directory, with the crew
# tools loaded and AGENTS.md as standing instructions.
set -eu

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DIR"
mkdir -p projects worktrees
exec "${FOREMAN_PI_BIN:-pi}" -e "$DIR/extensions/foreman.ts" "$@"
